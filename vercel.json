{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "aprizal.me" }],
      "destination": "https://www.aprizal.me/$1",
      "permanent": true
    },
    { "source": "/case-studies/evora/", "destination": "/work/evora/", "permanent": true },
    { "source": "/case-studies/flowforge/", "destination": "/work/flowforge/", "permanent": true },
    { "source": "/case-studies/snaphire/", "destination": "/work/snaphire/", "permanent": true },
    { "source": "/case-studies/klyra/", "destination": "/work/klyra/", "permanent": true }
  ]
}
