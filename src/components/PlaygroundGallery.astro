---
/**
 * Playground gallery: the image grid plus one preview modal per item.
 * Used on /playground/ and on the homepage. Selecting a card opens its
 * modal on the same page; nothing navigates.
 *
 * Grid: 1 column on phones, 2 from 640px, 3 from 1024px; on /playground/
 * a 4th column is added from 1440px (`maxColumns={4}`), the homepage keeps 3.
 *
 * Video cards (`thumbnail.video`): a muted, looping, inline video with the
 * still as its poster. Nothing is fetched until the card nears the viewport;
 * it plays only while visible and never with prefers-reduced-motion (the
 * poster stays). Without JavaScript the poster is shown.
 */
import PlaygroundModal from './PlaygroundModal.astro';
import { publicImageSize } from '../lib/imageSize';
import '../styles/playground.css';

interface Item {
  id: string;
  data: {
    title: string;
    subtitle?: string;
    category: string;
    description?: string;
    tools?: string[];
    details?: { label: string; value: string }[];
    year?: number;
    thumbnail: { src: string; alt: string; video?: string };
    video?: { src: string; poster: string; label: string };
    images: { src: string; alt: string }[];
  };
}

interface Props {
  items: Item[];
  maxColumns?: 3 | 4;
  /** Thumbnails loaded eagerly (the first rows above the fold). */
  eager?: number;
}

const { items, maxColumns = 4, eager = 0 } = Astro.props;
---
<ul class:list={['xp-grid', { 'xp-grid--max3': maxColumns === 3 }]} role="list">
  {items.map(({ id, data }, i) => {
    const size = publicImageSize(data.thumbnail.src);
    return (
      <li>
        <button class="xp-card" type="button" data-open={`xp-${id}`} aria-haspopup="dialog" aria-label={`Open preview: ${data.title}`}>
          <span class="xp-card__media">
            {data.thumbnail.video ? (
              <video
                class="xp-card__video"
                src={data.thumbnail.video}
                poster={data.thumbnail.src}
                width={size?.width}
                height={size?.height}
                muted
                loop
                playsinline
                preload="none"
                disablepictureinpicture
                aria-label={data.thumbnail.alt}
              />
            ) : (
              <img
                src={data.thumbnail.src}
                alt={data.thumbnail.alt}
                width={size?.width}
                height={size?.height}
                loading={i < eager ? 'eager' : 'lazy'}
                decoding="async"
              />
            )}
          </span>
        </button>
      </li>
    );
  })}
</ul>

{items.map(({ id, data }) => (
  <PlaygroundModal
    id={`xp-${id}`}
    title={data.title}
    subtitle={data.subtitle}
    category={data.category}
    year={data.year}
    description={data.description}
    tools={data.tools}
    details={data.details}
    video={data.video}
    images={data.images}
  />
))}

<script>
  // Open/close the Playground previews. Native <dialog> + showModal()
  // handles focus, Escape and making the page inert; this adds scroll
  // locking, backdrop clicks and returning focus to the card.
  const root = document.documentElement;
  let opener: HTMLElement | null = null;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // Video cards: play while on screen, pause when off screen or while a
  // preview is open (only one copy of a motion piece plays at a time).
  const cardVideos = [...document.querySelectorAll<HTMLVideoElement>('.xp-card__video')];
  const visible = new Set<HTMLVideoElement>();
  let previewOpen = false;

  const syncCards = () => {
    cardVideos.forEach((v) => {
      if (visible.has(v) && !previewOpen && !reduceMotion.matches) {
        v.play().catch(() => {}); // autoplay can still be refused (e.g. data saver): the poster stays
      } else if (!v.paused) {
        v.pause();
      }
    });
  };

  if (cardVideos.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach(({ target, isIntersecting }) => {
          const v = target as HTMLVideoElement;
          if (isIntersecting) visible.add(v);
          else visible.delete(v);
        });
        syncCards();
      },
      { threshold: 0.25 },
    );
    cardVideos.forEach((v) => io.observe(v));
    reduceMotion.addEventListener('change', syncCards);
  }

  const lockScroll = () => {
    const gap = window.innerWidth - root.clientWidth; // scrollbar width, so the page doesn't shift
    root.style.setProperty('overflow', 'hidden');
    if (gap > 0) document.body.style.setProperty('padding-right', `${gap}px`);
  };

  const unlockScroll = () => {
    root.style.removeProperty('overflow');
    document.body.style.removeProperty('padding-right');
  };

  document.querySelectorAll<HTMLButtonElement>('.xp-card[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dialog = document.getElementById(btn.dataset.open!) as HTMLDialogElement | null;
      if (!dialog) return;
      opener = btn;
      lockScroll();
      previewOpen = true;
      syncCards();
      dialog.showModal();
      dialog.querySelector<HTMLElement>('.xp-modal__panel')!.scrollTop = 0;
      dialog.querySelector<HTMLElement>('[data-close]')?.focus();
      // Motion piece at the top of the preview: muted autoplay, unless the
      // visitor prefers reduced motion (then the poster shows; controls stay).
      const video = dialog.querySelector<HTMLVideoElement>('.xp-modal__video');
      if (video && !reduceMotion.matches) video.play().catch(() => {});
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog.xp-modal').forEach((dialog) => {
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());

    // A click whose target is the <dialog> itself landed on the ::backdrop
    // (the panel covers the whole dialog box). Clicks on images or the
    // header have other targets and are ignored.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      dialog.querySelector<HTMLVideoElement>('.xp-modal__video')?.pause();
      previewOpen = false;
      syncCards();
      unlockScroll();
      opener?.focus();
      opener = null;
    });
  });
</script>
