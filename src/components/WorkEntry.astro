---
/**
 * One project in the /work/ list — Rizki Agus reference.
 *
 * Two columns from 768px: a square image on the left (the project's tint,
 * cover kept whole or filled per data/projectArt.ts), and the text on the
 * right, vertically centred: title, summary, and
 * "Read case study". No card box, no shadow: the image is the only shape.
 * Stacked (image first) on phones. The whole entry is one link.
 * Also used for the "Next case study" link at the end of each case study.
 */
import { publicImageSize, publicImageSrcset } from '../lib/imageSize';
import { projectArtFor } from '../data/projectArt';

interface Props {
  id: string;
  /** Project slug, for the cover's tint and fit. */
  slug?: string;
  href: string;
  num: string;
  title: string;
  type: string;
  year: number;
  summary: string;
  cover: string;
  coverAlt: string;
  tint?: string;
  priority?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { id, slug, href, num, title, type, year, summary, cover, coverAlt, tint, priority = false, headingLevel = 'h2' } = Astro.props;
const art = projectArtFor(slug ?? '');
const Heading = headingLevel;
const size = publicImageSize(cover);
const srcset = publicImageSrcset(cover);
const titleId = `${id}-title`;
---
<article class="entry" id={id}>
  <a
    class:list={['entry__link', `entry__link--${art.fit}`]}
    href={href}
    aria-labelledby={titleId}
    style={`--tint: ${tint ?? art.tint}; --pos: ${art.position}`}
  >
    <div class="entry__field">
      <img
        class="entry__img"
        src={cover}
        srcset={srcset}
        sizes={srcset ? '(min-width: 768px) 360px, 72vw' : undefined}
        alt={coverAlt}
        width={size?.width}
        height={size?.height}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'auto' : 'async'}
        fetchpriority={priority ? 'high' : undefined}
      />
    </div>

    <div class="entry__info">
      <Heading class="entry__title" id={titleId}>{title}</Heading>
      <p class="entry__summary">{summary}</p>
      <span class="entry__cta"><span class="entry__cta-text"><span class="roll"><span class="roll__text">Read case study</span></span></span> <span class="entry__arrow" aria-hidden="true">→</span></span>
    </div>
  </a>
</article>

<style>
  .entry {
    scroll-margin-top: var(--space-7);
  }

  .entry__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-5);
    color: var(--ink);
    text-decoration: none;
  }

  .entry__link:focus-visible {
    outline-offset: 6px;
    border-radius: var(--radius-image);
  }

  /* ---- Image: square tinted field ----------------------------------------- */
  .entry__field {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-image);
    background: var(--tint);
    box-shadow: var(--depth-edge), var(--shadow-rest);
    transition:
      box-shadow 450ms var(--ease-expo),
      transform 450ms var(--ease-expo);
  }

  .entry__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
    transition: transform var(--dur-media) var(--ease-media);
  }

  .entry__link--contain .entry__img {
    inset: 8%;
    width: 84%;
    height: 84%;
    object-fit: contain;
  }

  /* ---- Text ----------------------------------------------------------------- */
  .entry__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .entry__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-project); /* 24 → 40 */
    font-weight: var(--weight-heading);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-heading);
    text-transform: var(--case-heading);
  }

  .entry__summary {
    margin: var(--space-4) 0 0;
    max-width: 40ch;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }

  .entry__cta {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    margin-top: var(--space-5);
    font-size: var(--fs-body);
    font-weight: var(--weight-medium);
    color: var(--ink);
  }

  .entry__cta-text {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--line);
    transition: text-decoration-color var(--dur-fast) var(--ease-out);
  }

  .entry__arrow {
    display: inline-block;
    transition: transform var(--dur-base) var(--ease-out);
  }

  /* ---- Side by side from 768px: image | text (Rizki's 1:1 split) ---------- */
  @media (min-width: 768px) {
    .entry__link {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(var(--space-6), 4vw, var(--space-8));
      align-items: center;
    }
  }

  /* ---- Interaction ---------------------------------------------------------- */
  @media (hover: hover) and (pointer: fine) {
    .entry__link:hover .entry__img {
      transform: scale(1.04);
    }

    .entry__link:hover .entry__field {
      box-shadow: var(--depth-edge), var(--shadow-raised);
    }

    .entry__link:hover .entry__cta-text {
      text-decoration-color: var(--ink);
    }

    .entry__link:hover .entry__arrow {
      transform: translateX(4px);
    }
  }

  .entry__link:focus-visible .entry__arrow {
    transform: translateX(4px);
  }
</style>
