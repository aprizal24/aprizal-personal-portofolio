---
/**
 * Editorial case-study layout (Phase 3). Used by case studies whose
 * frontmatter sets `template: "editorial"`; the others keep the legacy
 * template in [slug].astro until they are migrated.
 *
 * Structure: hero (eyebrow, title, description, meta, hero image) → case-study
 * body from Markdown (styled by case-study-editorial.css, `cs-*` classes) →
 * ending (outro, next case study, contact). Uses the same floating nav and
 * footer as Home and Work.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from './SiteFooter.astro';
import WorkCard from './WorkCard.astro';
import '../styles/case-study-editorial.css';
import { site } from '../data/site';
import { projectTint } from '../data/projectArt';
import { caseStudyPath, routes } from '../lib/routes';
import { publicImageSize, publicImageSrcset } from '../lib/imageSize';

interface Meta { label: string; value: string }
interface Props {
  slug: string;
  title: string;
  description: string;
  heroImage: string;
  heroAlt: string;
  heroFill?: boolean;
  heroDevice?: boolean;
  meta: Meta[];
  order: number;
  outroTitle: string;
  outroText?: string;
  next: {
    id: string;
    data: {
      title: string;
      type: string;
      year: number;
      summary: string;
      cover: string;
      coverAlt: string;
      order: number;
    };
  };
}

const { slug, title, description, heroImage, heroAlt, heroFill = false, heroDevice = false, meta, order, outroTitle, outroText, next } = Astro.props;
const num = String(order).padStart(2, '0');
const heroSize = publicImageSize(heroImage);
const heroSrcset = publicImageSrcset(heroImage);
---
<BaseLayout title={`${title} · Case Study · ${site.name}`} description={description} ogType="article" nav>
<main id="main-content" tabindex="-1">

  <!-- Reading progress (CSS scroll-driven; hidden where unsupported) -->
  <div class="cs-progress" aria-hidden="true"></div>

  <!-- Hero (Koziol reference): breadcrumb, title, lead, facts, then the image -->
  <header class="cs-hero">
    <div class="container container--narrow">
      <p class="cs-hero__eyebrow rise" style="--i: 0">
        <a class="cs-hero__back" href={routes.work}><span class="roll"><span class="roll__text">Work</span></span></a>
        <span aria-hidden="true">/</span>
        <span>Case study {num}</span>
      </p>

      <h1 class="cs-hero__title"><span class="drop" style="--i: 1">{title}</span></h1>
      <p class="cs-hero__lead rise" style="--i: 2">{description}</p>

      <dl class="cs-hero__meta rise" style="--i: 3">
        {meta.map((m) => (
          <div class="cs-hero__meta-row">
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="container">
      <figure class:list={['cs-hero__media', 'rise', { 'cs-hero__media--fill': heroFill, 'cs-hero__media--device': heroDevice }]} style={`--tint: ${projectTint(slug)}; --i: 4`}>
        <img
          src={heroImage}
          srcset={heroSrcset}
          sizes={heroSrcset ? '(min-width: 1280px) 1200px, 100vw' : undefined}
          alt={heroAlt}
          width={heroSize?.width}
          height={heroSize?.height}
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </header>

  <!-- Case study body (Markdown) -->
  <div class="cs-body" style={`--cs-tint: ${projectTint(slug)}`}>
    <slot />
  </div>

  <!-- Ending -->
  <section class="cs-end container container--narrow" aria-labelledby="cs-end-title">
    <div class="cs-end__outro">
      <h2 class="cs-end__title" id="cs-end-title">{outroTitle}</h2>
      {outroText && <p class="cs-end__text">{outroText}</p>}
    </div>

    <div class="cs-end__next">
      <p class="cs-label">Next case study</p>
      <WorkCard
        id={`next-${next.id}`}
        slug={next.id}
        href={caseStudyPath(next.id)}
        title={next.data.title}
        summary={next.data.summary}
        cover={next.data.cover}
        coverAlt={next.data.coverAlt}
        headingLevel="h3"
        compact
      />
    </div>
  </section>

</main>

<SiteFooter />
</BaseLayout>
