---
/**
 * Home "Selected work" tile — Stan Reimg(en) reference.
 *
 * The image is the tile: a near-square white field,
 * the cover filling it (opaque screenshots crop edge to edge; transparent
 * device mockups sit whole, scaled up to fill most of the field — see
 * data/projectArt.ts). No border, no shadow, one radius.
 *
 * Hover (fine pointers) / keyboard focus: the tile and its image stay still
 * (no zoom, lift or movement); only the shadow becomes slightly more defined
 * and a small white label with the title and tagline fades in at the bottom
 * left (250ms).
 * Touch screens have no hover, so the label is always shown there.
 * The label text is always in the DOM and names the link.
 */
import { publicImageSize, publicImageSrcset } from '../lib/imageSize';

interface Props {
  id: string;
  href: string;
  title: string;
  tagline: string;
  type?: string;
  year?: number;
  cover: string;
  coverAlt: string;
  tint?: string;
  fit?: 'cover' | 'contain';
  position?: string;
  /** Load eagerly (above-the-fold tiles). */
  priority?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const {
  id, href, title, tagline, cover, coverAlt, tint,
  fit = 'contain', position = '50% 50%', priority = false, headingLevel = 'h3',
} = Astro.props;
const Heading = headingLevel;
const size = publicImageSize(cover);
const srcset = publicImageSrcset(cover);
const titleId = `${id}-title`;
const taglineId = `${id}-tagline`;
---
<article class="tile" id={id}>
  <a
    class:list={['tile__link', `tile__link--${fit}`]}
    href={href}
    aria-labelledby={`${titleId} ${taglineId}`}
    style={`--pos: ${position}`}
  >
    <div class="tile__field">
      <img
        class="tile__img"
        src={cover}
        srcset={srcset}
        sizes={srcset ? '(min-width: 768px) 36vw, 72vw' : undefined}
        alt={coverAlt}
        width={size?.width}
        height={size?.height}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'auto' : 'async'}
        fetchpriority={priority ? 'high' : undefined}
      />
    </div>
    <div class="tile__label">
      <Heading class="tile__title" id={titleId}>{title}</Heading>
      <span class="tile__tagline" id={taglineId}>{tagline}</span>
    </div>
  </a>
</article>

<style>
  .tile {
    scroll-margin-top: var(--space-7);
  }

  .tile__link {
    position: relative;
    display: block;
    border-radius: var(--radius-card);
    overflow: hidden;
    isolation: isolate; /* keeps the zooming image clipped to the radius in Safari */
    color: var(--ink);
    text-decoration: none;
    /* resting elevation: fine edge + soft cool shadow */
    box-shadow: var(--depth-edge), var(--shadow-rest);
    transition: box-shadow 250ms var(--ease-out);
  }

  .tile__link:focus-visible {
    outline-offset: 4px;
  }

  /* Near-square field (Stan's tiles are ~1.04:1; 6:5 keeps landscape covers large) */
  .tile__field {
    position: relative;
    aspect-ratio: 6 / 5;
    background: #ffffff;
  }

  .tile__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }

  /* Transparent mockups: whole, with an even white margin around them */
  .tile__link--contain .tile__img {
    inset: 7%;
    width: 86%;
    height: 86%;
    object-fit: contain;
  }

  /* ---- Label: white tag at the bottom left ------------------------------- */
  .tile__label {
    position: absolute;
    left: 16px;
    bottom: 16px;
    max-width: calc(100% - 32px);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    padding: 10px 16px;
    background: #ffffff;
    border-radius: 8px;
    box-shadow: var(--depth-edge), 0 6px 16px -8px rgb(30 50 90 / 0.25);
    line-height: 1.4;
    opacity: 0;
    transform: translateY(4px); /* inside the overlay: never moves the layout */
    transition:
      opacity 250ms var(--ease-out),
      transform 250ms var(--ease-out);
    pointer-events: none;
  }

  .tile__title {
    margin: 0;
    color: #3f444d;
    transition: color 250ms var(--ease-out);
    font-size: 0.9375rem;
    font-weight: var(--weight-subheading);
    letter-spacing: var(--tracking-subheading);
    font-family: var(--font-display);
    text-transform: var(--case-heading);
  }

  .tile__tagline {
    font-size: 0.875rem;
    color: var(--muted);
  }

  /* Hover / focus: a slightly firmer edge and a little more depth — the
     tile itself does not move or scale. */
  .tile__link:focus-visible {
    box-shadow: 0 0 0 1px rgb(20 30 50 / 0.08), var(--shadow-raised);
  }

  .tile__link:focus-visible .tile__label {
    opacity: 1;
    transform: none;
  }

  .tile__link:focus-visible .tile__title {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .tile__link:hover {
      box-shadow: 0 0 0 1px rgb(20 30 50 / 0.08), var(--shadow-raised);
    }

    .tile__link:hover .tile__label {
      opacity: 1;
      transform: none;
    }

    .tile__link:hover .tile__title {
      color: var(--ink);
    }
  }

  @media (hover: none) {
    .tile__label {
      opacity: 1;
      transform: none;
    }

    .tile__title {
      color: var(--ink);
    }
  }

  /* Reduced motion: the label only fades */
  @media (prefers-reduced-motion: reduce) {
    .tile__label {
      transform: none;
    }
  }
</style>
