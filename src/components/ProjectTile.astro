---
/**
 * Image-first project entry (Home Selected Work; reusable on Work).
 *
 * The visual: each cover sits whole (object-fit: contain, never cropped)
 * inside a calm 6:5 field washed with the project's own tint — one image,
 * not a card. No border, no shadow; corners use the shared --radius-card.
 *
 * The label (title + tagline) is hidden at rest and slides up inside the
 * image near the bottom —
 *   - on hover (fine pointers),
 *   - on keyboard focus,
 *   - on touch screens, while the tile sits in the middle of the viewport
 *     (index.astro toggles .is-inview). Without JS, touch shows the label.
 * The label text is always in the DOM and names the link for assistive tech.
 */
import { publicImageSize } from '../lib/imageSize';

interface Props {
  id: string;
  href: string;
  title: string;
  tagline: string;
  cover: string;
  coverAlt: string;
  /** Soft ground colour taken from the project's palette. */
  tint?: string;
  /** Load eagerly (above-the-fold tiles). */
  priority?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { id, href, title, tagline, cover, coverAlt, tint, priority = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const size = publicImageSize(cover);
const titleId = `${id}-title`;
const taglineId = `${id}-tagline`;
---
<article class="tile" id={id} data-tile>
  <a class="tile__link" href={href} aria-labelledby={`${titleId} ${taglineId}`} style={tint ? `--tint: ${tint}` : undefined}>
    <div class="tile__field">
      <img
        class="tile__img"
        src={cover}
        alt={coverAlt}
        width={size?.width}
        height={size?.height}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'auto' : 'async'}
        fetchpriority={priority ? 'high' : undefined}
      />
    </div>
    <div class="tile__label">
      <Heading class="tile__title" id={titleId}>{title}</Heading>
      <span class="tile__tagline" id={taglineId}>{tagline}</span>
    </div>
  </a>
</article>

<style>
  .tile {
    scroll-margin-top: var(--space-7);
  }

  .tile__link {
    --tint: var(--surface);
    position: relative;
    display: block;
    border-radius: var(--radius-card);
    overflow: hidden;
    isolation: isolate; /* keeps the zooming image clipped to the radius in Safari */
    color: var(--ink);
    text-decoration: none;
  }

  .tile__link:focus-visible {
    outline-offset: 6px;
  }

  /* The field: a quiet wash of the project's tint, fading toward the page. */
  .tile__field {
    position: relative;
    aspect-ratio: 6 / 5;
    background-color: var(--tint);
    background-image: linear-gradient(180deg, var(--tint) 0%, color-mix(in srgb, var(--tint) 30%, var(--bg)) 100%);
  }

  /* Breathing room inside the field; a little more below for the label. */
  .tile__img {
    position: absolute;
    inset: 6% 6% 12%;
    display: block;
    width: 88%;
    height: 82%;
    object-fit: contain;
    transition: transform 500ms var(--ease-out);
  }

  /* ---- Label inside the image, bottom-left ------------------------------ */
  .tile__label {
    position: absolute;
    left: clamp(12px, 3%, 20px);
    bottom: clamp(12px, 3%, 20px);
    max-width: calc(100% - 2 * clamp(12px, 3%, 20px));
    padding: 10px 14px;
    background: #ffffff;
    border-radius: 4px;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(10px) scale(0.98);
    transform-origin: left bottom;
    transition:
      opacity 300ms var(--ease-out),
      transform 380ms var(--ease-out);
    pointer-events: none;
  }

  .tile__title {
    display: inline;
    margin: 0 10px 0 0;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    font-weight: var(--weight-medium);
    letter-spacing: -0.01em;
  }

  .tile__tagline {
    font-size: 0.8125rem;
    color: #444;
  }

  /* Reveal: keyboard focus */
  .tile__link:focus-visible .tile__label {
    opacity: 1;
    transform: none;
  }

  /* Reveal: hover */
  @media (hover: hover) and (pointer: fine) {
    .tile__link:hover .tile__img {
      transform: scale(1.02);
    }

    .tile__link:hover .tile__label {
      opacity: 1;
      transform: none;
    }
  }

  /* Reveal: touch. No JS → always visible; with JS → only while in view. */
  @media (hover: none) {
    .tile__label {
      opacity: 1;
      transform: none;
    }

    :global(html.tiles-inview) .tile:not(.is-inview) .tile__label {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }
</style>
