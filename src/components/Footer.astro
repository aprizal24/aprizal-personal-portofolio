---
interface Props {
  name: string;
  social?: boolean;
}
const { name, social = false } = Astro.props;
---
<footer style="border-top:1px solid #ececec">
  <div style="max-width:1120px;margin:0 auto;padding:32px 24px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;font-size:13px;color:#8a8a8a">
    <div style="display:flex;flex-direction:column;gap:4px"><span style="color:#111;font-weight:500">{name}</span><span>UI/UX Designer · Lombok, Indonesia</span></div>
    {social && (
      <div style="display:flex;gap:20px">
        <a href="https://www.linkedin.com/in/aprizal-triansyah" target="_blank" rel="noopener" style="color:#555">LinkedIn</a>
        <a href="https://www.instagram.com/byaprizal" target="_blank" rel="noopener" style="color:#555">Instagram</a>
      </div>
    )}
    <span>© 2026 Aprizal Triansyah</span>
  </div>
</footer>
