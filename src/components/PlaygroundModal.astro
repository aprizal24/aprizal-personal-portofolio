---
/**
 * Preview for one Playground item — a native <dialog> opened with
 * showModal() by the gallery script in PlaygroundGallery.astro.
 *
 * showModal() gives the dialog semantics (role="dialog", aria-modal), moves
 * focus inside, closes on Escape and makes the page behind it inert. The
 * ::backdrop dims and blurs the page; the panel itself stays sharp.
 *
 * Layout: a sticky header (title, category, close button) above the images,
 * which are stacked edge to edge with no gaps, each at the full panel width
 * and its own aspect ratio. Only the panel's outer corners are rounded.
 * Images load lazily, so nothing is fetched until the dialog opens.
 * An optional motion piece (`video`) sits first in that stack: muted, looping,
 * with native controls and a poster; it is fetched only when the dialog opens
 * and played/paused by the gallery script. The description and optional
 * `tools` come last, after all the media, as the closing note.
 */
import { publicImageSize } from '../lib/imageSize';

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  category: string;
  year?: number;
  description?: string;
  tools?: string[];
  video?: { src: string; poster: string; label: string };
  images: { src: string; alt: string }[];
}

const { id, title, subtitle, category, year, description, tools, video, images } = Astro.props;
const titleId = `${id}-title`;
const meta = [subtitle, [category, year].filter(Boolean).join(', ')].filter(Boolean).join(' · ');
const videoSize = video ? publicImageSize(video.poster) : undefined;
---
<dialog class="xp-modal" id={id} aria-labelledby={titleId}>
  <div class="xp-modal__panel">
    <header class="xp-modal__head">
      <div class="xp-modal__heading">
        <h2 class="xp-modal__title" id={titleId}>{title}</h2>
        <p class="xp-modal__meta">{meta}</p>
      </div>
      <button class="xp-modal__close" type="button" data-close aria-label="Close preview">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </header>
    <div class="xp-modal__images">
      {video && (
        <video
          class="xp-modal__video"
          src={video.src}
          poster={video.poster}
          width={videoSize?.width}
          height={videoSize?.height}
          muted
          loop
          playsinline
          controls
          preload="none"
          disablepictureinpicture
          aria-label={video.label}
          style={videoSize ? `aspect-ratio: ${videoSize.width} / ${videoSize.height}` : undefined}
        />
      )}
      {images.map((img) => {
        const size = publicImageSize(img.src);
        return (
          <img src={img.src} alt={img.alt} width={size?.width} height={size?.height} loading="lazy" decoding="async" />
        );
      })}
    </div>
    {(description || (tools && tools.length > 0)) && (
      <div class="xp-modal__info">
        {description && <p class="xp-modal__desc">{description}</p>}
        {tools && tools.length > 0 && (
          <p class="xp-modal__tools"><span class="xp-modal__tools-label">Tools</span> {tools.join(', ')}</p>
        )}
      </div>
    )}
  </div>
</dialog>

<style>
  .xp-modal {
    /* Large presentation, inset from the viewport edges */
    width: min(1080px, /* = the images' own width, so they are never upscaled */ calc(100vw - 2 * clamp(12px, 4vw, 48px)));
    max-width: none;
    height: auto;
    max-height: calc(100dvh - 2 * clamp(12px, 4vh, 40px));
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: clamp(16px, 2vw, 24px);
    background: #ffffff;
    color: var(--ink);
    overflow: hidden; /* the panel scrolls; the dialog clips it to the rounded corners */
    box-shadow: 0 30px 80px -20px rgb(18 20 23 / 0.35);
  }

  .xp-modal::backdrop {
    background: rgb(18 20 23 / 0.32);
    -webkit-backdrop-filter: blur(12px) saturate(1.1);
    backdrop-filter: blur(12px) saturate(1.1);
  }

  /* The scrolling area fills the whole dialog, so a click on it is always a
     click inside; only the ::backdrop (target === dialog) closes it. */
  .xp-modal__panel {
    max-height: inherit;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none; /* still scrolls, no visible scrollbar */
  }

  .xp-modal__panel::-webkit-scrollbar {
    display: none;
  }

  .xp-modal__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-4) var(--space-4) clamp(var(--space-5), 3vw, var(--space-6));
    background: rgb(255 255 255 / 0.92);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .xp-modal__heading {
    min-width: 0;
  }

  .xp-modal__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.25rem);
    font-weight: var(--weight-bold);
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: var(--case-heading);
  }

  .xp-modal__meta {
    margin: 2px 0 0;
    font-size: var(--fs-meta);
    color: var(--muted);
  }

  /* Project info closes the preview, after all the media: plain text on the
     panel (no card), aligned with the header's left edge. */
  .xp-modal__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding:
      clamp(var(--space-6), 1rem + 2vw, var(--space-7))
      clamp(var(--space-5), 3vw, var(--space-6))
      clamp(var(--space-7), 1.5rem + 2.5vw, var(--space-8));
  }

  .xp-modal__desc {
    margin: 0;
    max-width: 60ch;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--muted);
  }

  .xp-modal__close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--light-surface);
    color: var(--ink);
    cursor: pointer;
    box-shadow: var(--shadow-control);
    transition:
      background-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .xp-modal__close:hover,
  .xp-modal__close:focus-visible {
    background: linear-gradient(180deg, #ffffff 0%, #e9edf3 100%);
  }

  .xp-modal__close:active {
    box-shadow: inset 0 1px 2px rgb(20 30 50 / 0.18), 0 0 0 1px rgb(20 30 50 / 0.07);
    transform: translateY(1px);
  }

  /* One continuous presentation: no gaps, margins, frames or radii between
     images; each fills the panel width at its natural aspect ratio. */
  .xp-modal__images {
    display: flex;
    flex-direction: column;
    gap: 0;
    line-height: 0;
  }

  .xp-modal__tools {
    margin: 0;
    font-size: var(--fs-meta);
    line-height: 1.5;
    color: var(--muted);
  }

  .xp-modal__tools-label {
    margin-right: 0.5em;
    font-weight: var(--weight-medium);
    color: var(--ink);
  }

  .xp-modal__images img,
  .xp-modal__video {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  /* Opening: a short fade and rise. */
  @media (prefers-reduced-motion: no-preference) {
    .xp-modal[open] {
      animation: xp-in 460ms var(--ease-smooth);
    }

    .xp-modal[open]::backdrop {
      animation: xp-fade 460ms var(--ease-smooth);
    }
  }

  @keyframes xp-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.985);
    }
  }

  @keyframes xp-fade {
    from {
      opacity: 0;
    }
  }
</style>
