---
/**
 * Global navigation — a small floating dock, centred at the bottom.
 *
 * Content: the name "Aprizal" on the left (the link to Home — there is no
 * Home menu item) and text labels on the right (Work, About, Contact). The
 * name stays inside the dock at every width; the gap between it and the menu
 * is generous from 1024px and tighter below, where the dock must stay narrow.
 *
 * States (unchanged)
 * - Active page: accent-blue item, always (idle, hovered, or while another
 *   item is hovered).
 * - Idle: quiet text on the white dock.
 * - Hover / keyboard focus: inactive items take the light grey tint and a
 *   very slight zoom. The tint/blue pill hugs the label (shorter than the
 *   tap area). The name "Aprizal" has no hover effect.
 * - Home: no menu item is active; the name is the way back.
 */
import { site } from '../data/site';
import { primaryNav, isActive, routes } from '../lib/routes';

const pathname = Astro.url.pathname;
---
<nav class="dock" aria-label="Primary">
  <a class="dock__name" href={routes.home}>{site.shortName}</a>
  <ul class="dock__list" role="list">
    {primaryNav.map((item) => {
      const active = isActive(item.href, pathname);
      return (
        <li>
          <a class="dock__link" href={item.href} aria-current={active ? 'page' : undefined}><span class="roll"><span class="roll__text">{item.label}</span></span></a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  /* ---- Dock ------------------------------------------------------------- */
  .dock {
    --item: 48px;
    --pad: 5px;
    position: fixed;
    inset-inline: 0;
    /* --nav-bottom (tokens.css): scales with viewport height (min 12px) so the
       gap looks the same at any zoom, plus the iOS home-indicator inset. */
    bottom: var(--nav-bottom);
    z-index: var(--z-nav);
    /* Centred via auto margins (not left:50%), so the dock gets the full
       viewport width to size into and labels never get squeezed. */
    width: fit-content;
    max-width: calc(100vw - 2 * var(--gutter));
    margin-inline: auto;
    padding: var(--pad);
    background: #ffffff;
    border-radius: 999px;
    box-shadow:
      0 1px 2px rgb(17 17 17 / 0.04),
      0 10px 32px rgb(17 17 17 / 0.08);
  }

  @media (min-width: 768px) {
    .dock {
      --item: 54px;
    }
  }

  /* With the name on the left, give the last item's pill the same breathing
     room on the right as it has above and below: (dock height − pill) / 2,
     i.e. (58 − 32) / 2 = 13px on mobile and (64 − 36) / 2 = 14px from 768px.
     Top, bottom and left padding stay at --pad. */
  .dock {
    padding-right: 13px;
  }

  @media (min-width: 768px) {
    .dock {
      padding-right: 14px;
    }
  }

  .dock {
    display: flex;
    align-items: center;
  }

  .dock__list {
    display: flex;
    align-items: center;
    gap: 4px; /* 6px from 1024px */
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 1024px) {
    .dock__list {
      gap: 6px;
    }
  }

  /* Menu items and the name: text centred in a box as tall as the dock's
     item row (the tap area, which also sets the dock's height). */
  .dock__link,
  .dock__name {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: var(--item);
    padding-inline: 14px;
    color: #3d3d3d;
    font-size: 0.9375rem;
    font-weight: var(--weight-medium);
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
  }

  /* Menu items below 1024px: 12px each side (the pill hugs the label with
     equal space left and right, as on desktop). This keeps the dock, now with
     the name inside, within 375px phones and clear of the footer text that
     shares its line at 768–1023px. */
  .dock__link {
    padding-inline: 12px;
  }

  /* Very narrow phones (< 360px): tighter still, so nothing overflows */
  @media (max-width: 359px) {
    .dock__link {
      padding-inline: 8px;
    }

    .dock .dock__name {
      padding-inline: 10px 4px;
      margin-right: 0;
    }
  }

  /* Roomier items only where the dock has space */
  @media (min-width: 1024px) {
    .dock__link,
    .dock__name {
      padding-inline: 18px;
    }
  }

  /* ---- Menu items ---------------------------------------------------------
     The visible pill (hover tint / active blue) is a layer behind the text,
     shorter than the tap area so it hugs the label; the link box keeps the
     full item height, so the dock's size doesn't change. */
  .dock__link {
    --pill: 32px;
    position: relative;
    isolation: isolate;
    transition:
      color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  @media (min-width: 768px) {
    .dock__link {
      --pill: 36px;
    }
  }

  .dock__link::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset-inline: 0;
    top: 50%;
    height: var(--pill);
    transform: translateY(-50%);
    border-radius: 999px;
    background-color: transparent;
    transition: background-color var(--dur-base) var(--ease-out);
  }

  /* Active page: blue in every state */
  .dock__link[aria-current='page'] {
    color: var(--ink); /* #111 on the accent pill: 5.72:1 (AA); white was 3.30:1 */
  }

  /* The active item keeps its still label (text roll is for other items) */
  .dock__link[aria-current='page'] .roll__text {
    transform: none;
  }

  .dock__link[aria-current='page']::before {
    background-color: var(--accent);
  }

  /* Keyboard focus: same tint as hover for inactive items; the outline
     follows the pill rather than the taller tap area. */
  .dock__link:not([aria-current='page']):focus-visible {
    color: var(--ink);
  }

  .dock__link:not([aria-current='page']):focus-visible::before {
    background-color: var(--hover-tint);
  }

  .dock__link:focus-visible {
    outline: none;
  }

  .dock__link:focus-visible::before {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .dock__link:not([aria-current='page']):hover {
      color: var(--ink);
      transform: scale(1.04);
    }

    .dock__link:not([aria-current='page']):hover::before {
      background-color: var(--hover-tint);
    }
  }

  /* ---- Name ---------------------------------------------------------------
     Static: no hover tint, zoom or colour change. Shown at every width.
     Keyboard focus keeps the standard outline only. */
  .dock__name {
    color: var(--ink);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.01em;
    margin-right: 4px; /* tighter gap where the dock must stay narrow */
  }

  @media (min-width: 1024px) {
    .dock__name {
      margin-right: clamp(40px, 4vw, 64px); /* generous gap before the menu */
    }
  }

  .dock__name:hover {
    color: var(--ink);
  }

  .dock__name:focus-visible {
    border-radius: 999px;
    outline-offset: -4px;
  }
</style>
