---
/**
 * Global navigation — a small floating pill of icons, fixed at the top right
 * (Home, Work, Playground, About). Labels appear as a dark tooltip under an
 * icon on hover or keyboard focus, and while an icon is pressed on touch
 * screens: the active pill's blue with white text for the current page, the hover tint with
 * ink text for the others. Each link carries its label as its accessible name.
 *
 * States (colours unchanged from the previous navbar):
 * - Active page: raised dark graphite pill (#3A3F47 → #1E2126), white icon.
 * - Hover / keyboard focus on other items: --hover-tint pill with a soft top
 *   highlight, ink icon, a 1px lift.
 * - Idle: #3f444d icon on the light bar.
 * Icons: Tabler outline (@tabler/icons, already used by the footer).
 */
import { primaryNav, isActive, type NavIcon } from '../lib/routes';
import { tablerIcon } from '../lib/icons';

const pathname = Astro.url.pathname;
const iconName: Record<NavIcon, string> = {
  home: 'home',
  work: 'stack-2',
  playground: 'triangle-square-circle',
  about: 'user',
};
---
<nav class="dock" aria-label="Primary">
  <ul class="dock__list" role="list">
    {primaryNav.map((item) => {
      const active = isActive(item.href, pathname);
      const svg = tablerIcon(iconName[item.icon]);
      return (
        <li class="dock__item">
          <a class="dock__link" href={item.href} aria-label={item.label} aria-current={active ? 'page' : undefined}>
            {svg ? <span class="dock__icon" aria-hidden="true" set:html={svg} /> : <span class="dock__fallback">{item.label}</span>}
          </a>
          <span class="dock__tip" aria-hidden="true">{item.label}</span>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  /* ---- Bar ---------------------------------------------------------------- */
  .dock {
    --item: 44px;
    --pad: 5px;
    position: fixed;
    top: calc(clamp(12px, 2vw, 24px) + env(safe-area-inset-top, 0px));
    right: max(clamp(12px, 2.5vw, 32px), env(safe-area-inset-right, 0px));
    z-index: var(--z-nav);
  }

  .dock__list {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: var(--pad);
    list-style: none;
    /* light, slightly cool surface lit from above (as before) */
    background: linear-gradient(180deg, rgb(255 255 255 / 0.94) 0%, rgb(247 249 252 / 0.92) 100%);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    backdrop-filter: saturate(1.6) blur(14px);
    border-radius: 999px;
    box-shadow: var(--depth-edge), var(--depth-highlight), var(--shadow-float);
  }

  @media (min-width: 768px) {
    .dock {
      --item: 48px;
      --pad: 6px;
    }

    .dock__list {
      gap: 6px;
    }
  }

  .dock__item {
    position: relative;
  }

  /* Entrance: the pill builds itself once per session (short). */
  @media (prefers-reduced-motion: no-preference) {
    .dock__list {
      animation: dock-in 700ms var(--ease-expo) 200ms both;
      transform-origin: 100% 0%;
    }

    .dock__item {
      animation: dock-items 400ms var(--ease-out) 520ms both;
    }
  }

  :global(html.dock-seen) .dock__list,
  :global(html.dock-seen) .dock__item {
    animation: none;
  }

  @keyframes dock-in {
    from {
      opacity: 0;
      transform: translateY(-12px) scale(0.7);
    }
  }

  @keyframes dock-items {
    from {
      opacity: 0;
    }
  }

  /* ---- Items: round icon buttons ----------------------------------------- */
  .dock__link {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: var(--item);
    height: var(--item);
    border-radius: 50%;
    color: #3f444d;
    text-decoration: none;
    transition: color var(--dur-base) var(--ease-out);
  }

  .dock__link::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: 50%;
    background-color: transparent;
    transition:
      background-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out),
      translate var(--dur-base) var(--ease-out);
  }

  .dock__icon {
    display: grid;
  }

  .dock__icon :global(svg) {
    width: 22px;
    height: 22px;
    stroke-width: 1.6;
  }

  .dock__fallback {
    font-size: 0.75rem;
  }

  /* Active page: raised ink pill, white icon (unchanged colours) */
  .dock__link[aria-current='page'] {
    color: #ffffff;
  }

  .dock__link[aria-current='page']::before {
    /* Dark graphite, raised: volume gradient, light top edge, contact +
       ambient shadow. Neutral, so it never competes with project colours. */
    background-color: #2A2E35;
    background-image: linear-gradient(180deg, #3A3F47 0%, #1E2126 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      0 1px 2px rgb(18 20 23 / 0.24),
      0 6px 14px -6px rgb(18 20 23 / 0.42);
  }

  /* white icon on graphite: a slightly firmer stroke keeps it crisp */
  .dock__link[aria-current='page'] .dock__icon :global(svg) {
    stroke-width: 1.9;
  }

  /* Hover / keyboard focus on other items: light tinted pill (unchanged) */
  .dock__link:not([aria-current='page']):focus-visible {
    color: var(--ink);
  }

  .dock__link:not([aria-current='page']):focus-visible::before {
    background-color: var(--hover-tint);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.8), 0 0 0 1px rgb(20 30 50 / 0.04);
  }

  .dock__link:focus-visible {
    outline: none;
  }

  .dock__link:focus-visible::before {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .dock__link:not([aria-current='page']):hover {
      color: var(--ink);
    }

    .dock__link:not([aria-current='page']):hover::before {
      background-color: var(--hover-tint);
      box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.8), 0 0 0 1px rgb(20 30 50 / 0.04);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .dock__link:not([aria-current='page']):hover::before {
      translate: 0 -1px;
    }
  }

  /* ---- Tooltip: dark pill under the icon ---------------------------------
     Positioned absolutely, so showing it never moves the bar or the other
     icons. Hidden from assistive tech (the link already has the label). */
  .dock__tip {
    position: absolute;
    top: calc(100% + var(--pad) + 8px);
    left: 50%;
    padding: 6px 12px;
    border-radius: 999px;
    /* non-active item: the same light tint as the icon's hover pill, ink
       text (16:1), with the pill's fine edge + top highlight so it reads
       against the page */
    background: var(--hover-tint);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: var(--weight-medium);
    line-height: 1.2;
    white-space: nowrap;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.8), 0 0 0 1px rgb(20 30 50 / 0.06), 0 6px 16px -8px rgb(30 50 90 / 0.25);
    opacity: 0;
    translate: -50% -4px;
    pointer-events: none;
    transition:
      opacity var(--dur-fast) var(--ease-smooth),
      translate var(--dur-base) var(--ease-smooth);
  }

  /* active page's item: the same graphite as the active pill, white text */
  .dock__item:has([aria-current='page']) .dock__tip {
    background: #2A2E35 linear-gradient(180deg, #3A3F47 0%, #1E2126 100%);
    color: #ffffff;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.14),
      0 6px 16px -8px rgb(18 20 23 / 0.45);
  }

  /* The last item's label would centre past the bar's right edge: align it
     to the icon's right edge instead so it never leaves the viewport. */
  .dock__item:last-child .dock__tip {
    left: auto;
    right: 0;
    translate: 0 -4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .dock__item:hover .dock__tip {
      opacity: 1;
      translate: -50% 0;
    }

    .dock__item:last-child:hover .dock__tip {
      translate: 0 0;
    }
  }

  .dock__item:focus-within .dock__tip {
    opacity: 1;
    translate: -50% 0;
  }

  .dock__item:last-child:focus-within .dock__tip {
    translate: 0 0;
  }

  /* Touch screens (no hover): the label shows while an icon is pressed
     (a permanent label would sit over page titles on small screens). */
  @media (hover: none) {
    .dock__item:has(.dock__link:active) .dock__tip {
      opacity: 1;
      translate: -50% 0;
      transition-duration: 80ms;
    }

    .dock__item:last-child:has(.dock__link:active) .dock__tip {
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dock__tip {
      transition: opacity 120ms linear;
    }
  }
</style>
