---
/**
 * Base document: <head> (SEO, social, icons), global styles and the skip link.
 * Pages render their own <main id="main-content" tabindex="-1">.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/typography.css';
import '../styles/layout.css';
import '../styles/legacy.css';
import { site } from '../data/site';
import { absoluteUrl } from '../lib/seo';
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title: string;
  description: string;
  /** Open Graph type: 'website' (default) or 'article' for case studies. */
  ogType?: 'website' | 'article';
  /** Keep the page out of search engines (noindex, nofollow). */
  noindex?: boolean;
  /** JSON-LD object(s) to embed, e.g. personSchema(). */
  schema?: object | object[];
  /** Render the global navigation (top wordmark + fixed bottom bar).
   *  Off for pages that still use the legacy Header. */
  nav?: boolean;
}

const { title, description, ogType = 'website', noindex = false, schema, nav = false } = Astro.props;

const siteBase = Astro.site ?? site.url;
const canonical = absoluteUrl(Astro.url.pathname, siteBase);
const ogImage = absoluteUrl(site.ogImage.path, siteBase);
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content={nav ? 'width=device-width, initial-scale=1, viewport-fit=cover' : 'width=device-width, initial-scale=1'}>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex, nofollow">}

<!-- Heading font: preloaded so titles don't swap late (Inter is the fallback) -->
<link rel="preload" href="/fonts/jost-latin.woff2" as="font" type="font/woff2" crossorigin>

<!-- Icons: all made from the About portrait (/images/about/profile.webp).
     favicon.ico (16/32/48) for browsers that ask for it by default; the
     apple-touch-icon (180×180) is what iPhone/iPad show on the Home Screen. -->
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="apple-mobile-web-app-title" content={site.shortName}>

<!-- Open Graph -->
<meta property="og:site_name" content={site.name}>
<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content={String(site.ogImage.width)}>
<meta property="og:image:height" content={String(site.ogImage.height)}>
<meta property="og:image:type" content={site.ogImage.type}>
<meta property="og:image:alt" content={site.ogImage.alt}>

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
<meta name="twitter:image:alt" content={site.ogImage.alt}>

{schemas.map((s) => <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />)}

<!-- The dock's entrance plays once per visit, not on every page change. -->
<script is:inline>
  try {
    if (sessionStorage.getItem('dock-seen')) document.documentElement.classList.add('dock-seen');
    else sessionStorage.setItem('dock-seen', '1');
  } catch (e) {}
</script>
</head>
<body class={nav ? 'has-bottom-nav' : undefined}>
<a class="skip-link" href="#main-content">Skip to content</a>
{nav && <SiteNav />}
<slot />

<!-- Scroll reveal (styles in base.css). Runs inline at the end of the body,
     before first paint, so nothing visible is hidden afterwards. Each target
     is tagged `.rv` only once the observer exists; it is revealed once and
     then unobserved. Skipped entirely with reduced motion or without
     IntersectionObserver, leaving all content visible. -->
<script is:inline>
  (() => {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Text blocks: fade + 16px rise.
    const up = [
      '.home-work__title',
      '.home-work__grid > li',
      '.xp-grid > li',
      '.home-contact__title',
      '.wcard__body',
      '.cs-head',
      '.about-skills .about-row',
      '.about-connect .about-row',
    ];
    // Project images: fade + soft lower-edge unmask.
    const media = [
      '.wcard__img',
      '.cs-figure img',
      '.cs-gallery img',
      '.cs-screen__media img',
      '.cs-profile__photo img',
    ];

    const io = new IntersectionObserver(
      (entries) => {
        // Items entering together get a gentle stagger (110ms, max 3 steps).
        entries
          .filter((e) => e.isIntersecting)
          .forEach((e, k) => {
            e.target.style.setProperty('--rv-delay', Math.min(k, 3) * 110 + 'ms');
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          });
      },
      // The huge top margin counts everything above the viewport as already
      // seen (e.g. after Back restores a scroll position), so nothing is left
      // hidden behind the reader; below, items reveal a little before 100%.
      { rootMargin: '100000px 0px -8% 0px' },
    );

    const tag = (selectors, extra) => {
      document.querySelectorAll(selectors.join(',')).forEach((el) => {
        if (el.closest('.rise, .drop, dialog')) return; // already animated, or inside a modal
        el.classList.add('rv');
        if (extra) el.classList.add(extra);
        io.observe(el);
      });
    };
    tag(up);
    tag(media, 'rv--media');
  })();
</script>
</body>
</html>
