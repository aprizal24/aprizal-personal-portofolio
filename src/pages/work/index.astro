---
/**
 * /work/ — the complete project archive.
 * Data: the case-studies content collection (same source as Home), ordered by
 * `order`. Links go through caseStudyPath() (/work/{slug}/).
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/work.css';
import { site } from '../../data/site';
import { caseStudyPath } from '../../lib/routes';

const projects = (await getCollection('case-studies'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({
    id: e.id,
    href: caseStudyPath(e.id),
    ...e.data,
  }));

const names = projects.map((p) => p.title);
const description = `Case studies by ${site.name}, ${site.role}: ${names.slice(0, -1).join(', ')} and ${names.at(-1)}.`;
---
<BaseLayout title={`Work · ${site.name}`} description={description} nav>
<main id="main-content" tabindex="-1">

  <header class="work-head container container--narrow">
    <h1 class="work-head__title"><span class="drop" style="--i: 0">Work</span></h1>
  </header>

  <section class="work-list container container--narrow" aria-label="Case studies">
    <ol class="work-list__items" role="list">
      {projects.map((p, i) => (
        <li>
          <WorkCard
            id={p.id}
            slug={p.id}
            href={p.href}
            title={p.title}
            summary={p.summary}
            cover={p.cover}
            coverAlt={p.coverAlt}
            priority={i === 0}
          />
        </li>
      ))}
    </ol>
  </section>

</main>

<SiteFooter />
</BaseLayout>
